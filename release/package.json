{
    "name": "@geysermc/actions-release",
    "private": true,
    "version": "1.0.0",
    "description": "An action to create incremented releases in a similar style to Jenkins",
    "author": "GeyserMC",
    "license": "AGPL-3.0-only",
    "exports": {
        ".": "./dist/index.js"
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "package": "esbuild index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js --external:*.node --legal-comments=external && tsc --emitDeclarationOnly --declaration",
        "package:watch": "npm run package -- --watch"
    },
    "dependencies": {
        "@actions/core": "3.0.1",
        "@octokit/auth-app": "8.3.1",
        "@octokit/core": "7.0.8",
        "@octokit/plugin-rest-endpoint-methods": "18.0.0",
        "@vermaysha/discord-webhook": "1.4.0",
        "glob": "13.0.6",
        "markdown-escape": "2.0.0",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@types/markdown-escape": "1.1.3",
        "js-yaml": "5.5.0"
    }
}
